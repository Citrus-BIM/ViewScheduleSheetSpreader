<Window x:Class="ViewScheduleSheetSpreader.ViewScheduleSheetSpreaderWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:ViewScheduleSheetSpreader"
        mc:Ignorable="d" 
        Title="Спецификации на листы"
        Height="680" Width="800"
        MinHeight="680" MinWidth="700"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        Icon="Resources/citrus.ico"
        WindowStartupLocation="CenterScreen"
        KeyDown="ViewScheduleSheetSpreaderWPF_KeyDown"
        FontFamily="{DynamicResource BaseFont}"
        FontSize="{DynamicResource FontSizeBase}"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBgBrush}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Language="ru-RU">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitrusTheme/CitrusTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- строки: контент + низ с кнопками -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <!-- Слева: настройки листов -->
            <ColumnDefinition Width="300"/>
            <!-- Справа: списки спецификаций -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ПРАВАЯ ЧАСТЬ (списки) -->
        <Grid Margin="0" Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <!-- Поиск -->
                <RowDefinition Height="Auto"/>
                <!-- Верхний блок -->
                <RowDefinition Height="*"/>
                <!-- Нижний блок -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Поиск по спецификациям -->
            <Grid Grid.Row="0"
                  Margin="10,4,10,4"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="Поиск спецификаций:"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Margin="0,0,4,0"/>

                <TextBox x:Name="textBox_SearchViewSchedule"
                         Grid.Column="1"
                         Height="32"
                         HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center"
                         TextChanged="textBox_SearchViewSchedule_TextChanged"/>
            </Grid>

            <!-- ВЕРХНИЙ БЛОК: Спецификации в проекте -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label x:Name="label_ViewScheduleInProject"
                       Content="Спецификации в проекте:"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Grid.Row="0"
                       Margin="10,0,10,0"/>

                <ListBox x:Name="listBox_ViewScheduleInProjectCollection"
                         Grid.Row="1"
                         Margin="10,4,10,0"
                         SelectionMode="Extended"/>

                <!-- Кнопки под верхним списком -->
                <UniformGrid Grid.Row="2"
                     Margin="10,4,10,0"
                     Columns="2">
                    <Button x:Name="btn_Add"
                        Content="Добавить ▼"
                        Height="32"
                        Margin="0,0,4,0"
                        Click="btn_Add_Click"/>
                    <Button x:Name="btn_Exclude"
                        Content="Убрать ▲"
                        Height="32"
                        Margin="4,0,0,0"
                        Click="btn_Exclude_Click"/>
                </UniformGrid>
            </Grid>

            <!-- НИЖНИЙ БЛОК: Спецификации для размещения -->
            <Grid Grid.Row="2" Margin="0,4,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Label x:Name="label_SelectedViewSchedule"
                       Content="Спецификации для размещения:"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Grid.Row="0"
                       Margin="10,0,10,0"/>

                <ListBox x:Name="listBox_SelectedViewScheduleCollection"
                     Grid.Row="1"
                     Margin="10,4,10,0"
                     SelectionMode="Extended"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="listBox_SelectedViewScheduleCollection_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="listBox_SelectedViewScheduleCollection_PreviewMouseMove"
                     Drop="listBox_SelectedViewScheduleCollection_Drop"
                     DragOver="listBox_SelectedViewScheduleCollection_DragOver"/>
                <!-- Порядок позже будем делать перетаскиванием -->
            </Grid>
        </Grid>

        <!-- ЛЕВАЯ ЧАСТЬ (настройки листов) -->
        <StackPanel Grid.Column="0" Grid.Row="0">
            <GroupBox x:Name="groupBox_SheetSize"
                      Header="Размер листа по:"
                      Height="60"
                      VerticalAlignment="Top"
                      Margin="10,4,10,0">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22*"/>
                        <ColumnDefinition Width="87*"/>
                        <ColumnDefinition Width="109*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="radioButton_Instance"
                                 Content="Экземпляр"
                                 HorizontalAlignment="Center"
                                 Margin="15,0,15,0"
                                 VerticalAlignment="Center"
                                 IsChecked="True"
                                 Checked="radioButton_Checked"
                                 Grid.ColumnSpan="2"/>
                    <RadioButton x:Name="radioButton_Type"
                                 Content="Тип"
                                 Margin="35,0,35,0"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Grid.Column="2"
                                 Checked="radioButton_Checked"/>
                </Grid>
            </GroupBox>

            <Label x:Name="label_FirstSheetFamily"
                   Content="Семейство 1-го листа:"
                   Margin="10,0"
                   VerticalAlignment="Top"/>
            <ComboBox x:Name="comboBox_FirstSheetFamily"
                      Margin="10,0,10,0"
                      VerticalAlignment="Top"
                      Height="32"
                      VerticalContentAlignment="Center"
                      SelectionChanged="comboBox_FirstSheetFamily_SelectionChanged"/>

            <Label x:Name="label_FirstSheetType"
                   Content="Тип 1-го листа:"
                   Margin="10,5,10,0"
                   VerticalAlignment="Top"/>
            <ComboBox x:Name="comboBox_FirstSheetType"
                      Margin="10,0,10,0"
                      VerticalAlignment="Top"
                      Height="32"
                      VerticalContentAlignment="Center"
                      SelectionChanged="comboBox_FirstSheetType_SelectionChanged"/>

            <Label x:Name="label_FollowingSheetsFamily"
                   Content="Семейство последующих листов:"
                   VerticalAlignment="Top"
                   Margin="10,5,10,0"/>
            <ComboBox x:Name="comboBox_FollowingSheetsFamily"
                      Margin="10,0,10,0"
                      VerticalAlignment="Top"
                      Height="32"
                      VerticalContentAlignment="Center"
                      SelectionChanged="comboBox_FollowingSheetsFamily_SelectionChanged"/>

            <Label x:Name="label_FollowingSheetsType"
                   Content="Тип последующих листов:"
                   VerticalAlignment="Top"
                   Margin="10,5,10,0"/>
            <ComboBox x:Name="comboBox_FollowingSheetsType"
                      Margin="10,0,10,0"
                      VerticalAlignment="Top"
                      Height="32"
                      VerticalContentAlignment="Center"/>

            <Label x:Name="label_SheetFormatParameter"
                   Content="Параметр формата листа:"
                   Margin="10,5,10,0"
                   VerticalAlignment="Top"/>
            <ComboBox x:Name="comboBox_SheetFormatParameter"
                      Margin="10,0,10,0"
                      VerticalAlignment="Top"
                      Height="32"
                      VerticalContentAlignment="Center"/>

            <!-- X/Y убраны -->

            <Grid>
                <Label x:Name="label_FirstSheetNumber"
                       Content="Номер 1-го листа:"
                       Margin="10,10,160,0"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"/>
                <TextBox x:Name="textBox_FirstSheetNumber"
                         Height="32"
                         Margin="140,10,10,0"
                         TextWrapping="Wrap"
                         Text="69"
                         VerticalAlignment="Top"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"/>
            </Grid>

            <Grid>
                <Label x:Name="label_SheetNumberSuffix"
                       Content="Суффикс номера:"
                       Margin="10,5,160,0"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"/>
                <TextBox x:Name="textBox_SheetNumberSuffix"
                         Height="32"
                         Margin="140,5,10,0"
                         TextWrapping="Wrap"
                         Text="а"
                         VerticalAlignment="Top"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"/>
            </Grid>

            <GroupBox x:Name="groupBox_HeaderInSpecificationHeader"
                      Header="Шапка в заголовке спецификации:"
                      Height="60"
                      VerticalAlignment="Top"
                      Margin="10,10,10,0">
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22*"/>
                        <ColumnDefinition Width="87*"/>
                        <ColumnDefinition Width="109*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="radioButton_Yes"
                                 Content="Да"
                                 HorizontalAlignment="Center"
                                 Margin="15,0,15,0"
                                 VerticalAlignment="Center"
                                 IsChecked="True"
                                 Checked="radioButton_HeaderInSpecificationHeader_Checked"
                                 Grid.ColumnSpan="2"/>
                    <RadioButton x:Name="radioButton_No"
                                 Content="Нет"
                                 Margin="35,0,35,0"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Grid.Column="2"
                                 Checked="radioButton_HeaderInSpecificationHeader_Checked"/>
                </Grid>
            </GroupBox>

            <Grid>
                <Label x:Name="label_SpecificationHeaderHeight"
                       Content="Высота шапки:"
                       Margin="10,10,160,0"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"/>
                <TextBox x:Name="textBox_SpecificationHeaderHeight"
                         Height="32"
                         Margin="140,10,10,0"
                         TextWrapping="Wrap"
                         Text="40"
                         VerticalAlignment="Top"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!-- Кнопки ОК / Отмена под правой частью -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="btn_Ok"
                    Content="Ок"
                    HorizontalAlignment="Right"
                    Margin="0,0,125,10"
                    VerticalAlignment="Bottom"
                    Width="100"
                    Height="32"
                    Click="btn_Ok_Click"
                    Grid.Column="1"/>
            <Button x:Name="btn_Cancel"
                    Content="Отмена"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,10"
                    VerticalAlignment="Bottom"
                    Width="100"
                    Height="32"
                    Click="btn_Cancel_Click"
                    Grid.Column="1"/>
        </Grid>

    </Grid>
</Window>
